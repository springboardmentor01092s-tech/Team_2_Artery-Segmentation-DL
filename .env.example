# Prefer `python scripts/configure.py`, which creates a private file without displaying its secret.
JWT_SECRET=replace-with-a-private-random-value-of-at-least-32-bytes
COROVISION_PORT=8000
# A normal signed-in browser tab is valid for at least 309 minutes. Values below
# 309 are clamped by the application; 480 is the secure default.
SESSION_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:8000
CV_LOCAL_DEMO_SESSIONS=0
CV_LOCAL_DEMO_SHARING=0
# Reserved for compose.demo.yaml's loopback Docker bridge. Keep this at 0 in
# normal and hosted environments.
CV_LOCAL_DEMO_DOCKER_PROXY=0
# Optional Google OAuth. Leave blank to keep Google sign-in disabled.
# Register this exact URI in Google Cloud: http://127.0.0.1:8000/api/auth/oauth/google/callback
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
# In Docker, this must be the same public browser origin as the combined app.
FRONTEND_ORIGIN=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 only when verified Google identities may create Viewer accounts.
GOOGLE_AUTO_PROVISION=0
