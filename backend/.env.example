# Set these in the backend shell before starting uvicorn. Do not commit real secrets.
# JWT_SECRET=generate-a-random-value-before-deployment
# Local prototype only: keep remembered/password and OAuth sessions for 30 days.
# CV_LOCAL_DEMO_SESSIONS=1
# Local prototype only: automatically share seeded demo cases with the demo team.
# CV_LOCAL_DEMO_SHARING=1
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional preserved training artifact folder; install with scripts/install_trained_release.py.
# COROVISION_TRAINED_RELEASE=C:/path/to/Team_2_Artery-Segmentation-DL/models/trained_release
# COROVISION_MODEL_PROVIDER=legacy  # Roll back to the repository's original model-selection path.
OAUTH_REDIRECT_BASE=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
